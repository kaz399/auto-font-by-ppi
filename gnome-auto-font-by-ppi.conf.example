# Example configuration for gnome-auto-font-by-ppi.sh
# Copy this file to ~/.config/gnome-auto-font-by-ppi.conf or load it with --config.

# Select a preferred display by connector name.
# Leave empty to use the auto-detected primary display.
PREFERRED_DISPLAY="HDMI-1"

# Allowed values: scaling_only, full_fonts
APPLY_MODE="full_fonts"

# Override bogus physical monitor size values reported by EDID.
# Format: NAME=INCHES[,NAME=INCHES...]
MONITOR_DIAGONAL_OVERRIDES="HDMI-1=31.5,eDP-1=14.0"

# Treat detected PPI outside this range as suspicious.
MIN_REASONABLE_PPI=50
MAX_REASONABLE_PPI=400
